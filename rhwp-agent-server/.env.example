# rhwp-agent-server 환경변수 템플릿
# 사용법: cp .env.example .env 후 값 채우기

PORT=3000

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_TIMEOUT_MS=30000

# Session (멀티턴 히스토리 관리, R-4-I)
SESSION_TTL_MS=1800000
SESSION_MAX_HISTORY=50

# CORS 허용 origin (comma-separated, R-6-C)
# 기본값: rhwp-studio dev (7700) / preview (4173) / e2e (7711, 7712)
CORS_ALLOWED_ORIGINS=http://localhost:7700,http://localhost:4173,http://localhost:7711,http://localhost:7712
